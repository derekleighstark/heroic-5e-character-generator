    },
    "Item": {
      "power": { "htmlFields": ["description"] },
      "talent": { "htmlFields": ["description"] },
      "merit": { "htmlFields": ["description"] },
      "flaw": { "htmlFields": ["description"] },
      "calling": { "htmlFields": ["description"] },
      "origin": { "htmlFields": ["description"] },
      "class": { "htmlFields": ["description"] },
      "feature": { "htmlFields": ["description"] },
      "equipment": { "htmlFields": ["description"] }
    }
  },
  "packs": [
    { "name": "talents", "label": "Heroic 5e Talents", "path": "packs/talents", "type": "Item", "system": "heroic5e" },
    { "name": "merits", "label": "Heroic 5e Merits", "path": "packs/merits", "type": "Item", "system": "heroic5e" },
    { "name": "flaws", "label": "Heroic 5e Flaws", "path": "packs/flaws", "type": "Item", "system": "heroic5e" },
    { "name": "callings", "label": "Heroic 5e Callings & Triggers", "path": "packs/callings", "type": "Item", "system": "heroic5e" },
    { "name": "powers", "label": "Heroic 5e Powers", "path": "packs/powers", "type": "Item", "system": "heroic5e" },
    { "name": "origins", "label": "Heroic 5e Origins", "path": "packs/origins", "type": "Item", "system": "heroic5e" },
    { "name": "classes", "label": "Heroic 5e Classes", "path": "packs/classes", "type": "Item", "system": "heroic5e" },
    { "name": "featured-heroes", "label": "Heroic 5e Featured Heroes", "path": "packs/featured-heroes", "type": "Actor", "system": "heroic5e" },
    { "name": "ready-templates", "label": "Heroic 5e Ready-to-Play Templates", "path": "packs/ready-templates", "type": "Actor", "system": "heroic5e" },
    { "name": "npcs-opponents", "label": "Heroic 5e NPCs & Opponents", "path": "packs/npcs-opponents", "type": "Actor", "system": "heroic5e" }
  ],
  "socket": false,
  "initiative": "1d20 + @initiative"
